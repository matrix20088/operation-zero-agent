{"ok":true,"data":{"method":"datasets","result":{"bulk_max":10,"data_sha256_how":"data_sha256 = lowercase hex SHA-256 of the UTF-8 bytes of Python json.dumps(data, sort_keys=True, separators=(',',':'), ensure_ascii=False), data being the item's data as parsed from the response","datasets":[{"available":true,"cache_ttl_seconds":21600,"description":"Daily summaries for a GHCN weather station (NOAA NCEI): peak gust, average wind, max/min temperature, precipitation.","id":"noaa_station_daily","key":null,"output":"data: station, requested_station, start_date, end_date, count, peak_gust_max_mph, peak_gust_max_date, days[] (newest first: date, peak_gust_mph, peak_gust_ms, peak_gust_element, avg_wind_mph, avg_wind_ms, tmax_c, tmax_f, tmin_c, tmin_f, precip_mm), truncated","params":[{"doc":"GHCN id (USW00014755) or alias: KMWN, MOUNT WASHINGTON, MT WASHINGTON, KJFK, KORD, KDEN, KLAX","max_bytes":256,"name":"station","pattern":"^[A-Za-z0-9 ]{2,24}$","required":true,"type":"string"},{"doc":"first day; default end_date minus 29 days","format":"YYYY-MM-DD","name":"start_date","required":false,"type":"date"},{"doc":"last day; default yesterday (UTC)","format":"YYYY-MM-DD","name":"end_date","required":false,"type":"date"},{"default":"WSFG,WSF5,WSF2,AWND,TMAX,TMIN,PRCP","doc":"comma-separated subset of WSFG,WSF5,WSF2,AWND,TMAX,TMIN,PRCP, each at most once","max_bytes":256,"name":"elements","pattern":"^[A-Z0-9]{4}(,[A-Z0-9]{4}){0,6}$","required":false,"type":"string"},{"default":"31","doc":"most rows returned, newest first","max":200,"min":1,"name":"limit","required":false,"type":"int"}],"price":1,"resource":"credit","schema_version":1,"source":{"attribution":"NOAA NCEI, Global Historical Climatology Network daily","hosts":["www.ncei.noaa.gov"],"licence":"US government work, public domain","publisher":"NOAA National Centers for Environmental Information (GHCN-Daily)","terms_status":"public domain (US government)","terms_url":"https://www.ncei.noaa.gov/support/access-data-service-api-user-documentation"},"text_is_untrusted":false,"title":"NOAA station daily weather"},{"available":true,"cache_ttl_seconds":43200,"description":"NSIDC Sea Ice Index daily Arctic extent: a day's extent, its rank among the same day in every year (1 = record low) and its anomaly against that day's mean over every year in the file (anomaly_baseline; not a 1981-2010 climatology); optionally the series over a date range.","id":"sea_ice_extent","key":null,"output":"data: series_id, units (million km2), averaging, date, extent_km2, extent_million_km2, rank_low_to_high, n_years, anomaly_million_km2, anomaly_baseline, observations[] (newest first: date, value; the latest limit days unless start_date/end_date narrow it), count, truncated, next_end_date","params":[{"doc":"the day to rank; default the latest available","format":"YYYY-MM-DD","name":"date","required":false,"type":"date"},{"doc":"series from this day (inclusive)","format":"YYYY-MM-DD","name":"start_date","required":false,"type":"date"},{"doc":"series to this day (inclusive)","format":"YYYY-MM-DD","name":"end_date","required":false,"type":"date"},{"default":"366","doc":"most rows returned, newest first; fills observations[] with the latest rows when start_date/end_date are unset; next_end_date pages back when passed as end_date","max":1200,"min":1,"name":"limit","required":false,"type":"int"}],"price":1,"resource":"credit","schema_version":1,"source":{"attribution":"NSIDC Sea Ice Index, Version 4 (G02135), National Snow and Ice Data Center, Boulder, Colorado","hosts":["noaadata.apps.nsidc.org"],"licence":"free to use; citation requested","publisher":"National Snow and Ice Data Center (NSIDC), Sea Ice Index v4 (G02135)","terms_status":"citation requested; verify before production","terms_url":"https://nsidc.org/data/g02135/versions/4"},"source_fetchable":false,"source_note":"the source's robots.txt keeps fetch.page out; to check a value, stamp sources[].raw_sha256 (SHA-256 of the upstream bytes SwarmMemo received) with notary","text_is_untrusted":false,"title":"Arctic sea-ice extent"},{"available":true,"cache_ttl_seconds":3600,"description":"US food recalls for a company from FDA openFDA food enforcement, matched by firm name, with status, class, product, reason and date. USDA FSIS (meat, poultry, egg products) is included only when its server answers us; it currently blocks our servers, so sources_failed lists FSIS.","id":"food_recalls","key":null,"output":"data: firm_query, status_filter, count, total_matches, partial (true when a source failed: the counts cover sources_checked only), recalls[] (newest first: source, firm, product, date, status, classification, reason), sources_checked, sources_failed","params":[{"doc":"recalling company name, matched as a substring (FSIS) and a phrase (openFDA)","max_bytes":100,"name":"firm","pattern":"^[\\p{L}\\p{N} .,'&()/+:-]+$","required":true,"type":"string"},{"doc":"active (FDA: Ongoing) or closed (Completed, Terminated); default both","enum":["active","closed"],"name":"status","required":false,"type":"enum"},{"default":"10","doc":"most rows returned, newest first","max":50,"min":1,"name":"limit","required":false,"type":"int"}],"price":1,"resource":"credit","schema_version":1,"source":{"attribution":"USDA FSIS recall API; openFDA food enforcement reports","hosts":["www.fsis.usda.gov","api.fda.gov"],"licence":"US government works, public domain (openFDA: CC0)","publisher":"USDA Food Safety and Inspection Service; US Food and Drug Administration (openFDA)","terms_status":"public domain (US government)","terms_url":"https://open.fda.gov/terms/"},"text_is_untrusted":true,"title":"US food recalls"},{"available":true,"cache_ttl_seconds":3600,"description":"Recently active bills in a Congress whose title or latest action contains every query word (Congress.gov has no full-text search: the 250 most recently updated bills are scanned), with the latest action and its date.","id":"congress_bills","key":{"file":"api_data_gov.key","optional":false},"output":"data: query, congress, count (matches), scanned, bills[] (newest action first: bill, title, latest_action, latest_action_date, congress)","params":[{"doc":"words that must all appear in the title or latest action","max_bytes":200,"name":"query","pattern":"^[\\p{L}\\p{N} .,'&()/+:-]+$","required":true,"type":"string"},{"default":"the current Congress","doc":"Congress number, e.g. 119","max":999,"min":1,"name":"congress","required":false,"type":"int"},{"default":"8","doc":"most rows returned, newest first","max":50,"min":1,"name":"limit","required":false,"type":"int"}],"price":1,"resource":"credit","schema_version":1,"source":{"attribution":"Congress.gov","hosts":["api.congress.gov"],"licence":"US government work, public domain","publisher":"Library of Congress, Congress.gov API v3","terms_status":"public domain (US government); api.data.gov key terms apply","terms_url":"https://api.congress.gov/"},"text_is_untrusted":true,"title":"US Congress bills"},{"available":true,"cache_ttl_seconds":21600,"description":"A US federal candidate's campaign-finance top line from the FEC: receipts, disbursements, cash on hand and debts, for the latest or a given two-year cycle.","id":"fec_candidate_totals","key":{"file":"api_data_gov.key","optional":false},"output":"data: candidate_name, candidate_id, cycle, receipts, disbursements, cash_on_hand, debts (US dollars), count (1 found, 0 not)","params":[{"doc":"candidate name (the best FEC match is used); or give candidate_id","max_bytes":100,"name":"candidate","pattern":"^[\\p{L} .,'-]{2,100}$","required":false,"type":"string"},{"doc":"FEC candidate id, e.g. H2TX30123","max_bytes":256,"name":"candidate_id","pattern":"^[HSP][0-9A-Z]{8}$","required":false,"type":"string"},{"doc":"even election cycle year; default the latest","max":2100,"min":1976,"name":"cycle","required":false,"type":"int"}],"price":1,"resource":"credit","schema_version":1,"source":{"attribution":"Federal Election Commission (api.open.fec.gov)","hosts":["api.o